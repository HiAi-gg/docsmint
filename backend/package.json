{
  "name": "@hiai-docs/backend",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --define process.env.NODE_ENV='\"production\"' --external drizzle-orm --external drizzle-orm/* --external postgres --external pino --external pino/*",
    "start": "bun run dist/index.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:contract",
    "test:unit": "bun --no-env-file run scripts/run-hermetic-tests.ts src",
    "test:contract": "bun --no-env-file run scripts/run-hermetic-tests.ts tests/integration",
    "reembed": "bun run scripts/reembed-all.ts",
    "benchmark:graph": "bun run src/scripts/benchmark-graph.ts",
    "benchmark:search": "bun run src/scripts/benchmark-search.ts",
    "eval:retrieval": "bun run src/scripts/eval-retrieval.ts",
    "seed:benchmark-search": "bun run src/scripts/seed-benchmark-search.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@hiai-docs/db": "workspace:*",
    "@hiai-docs/sdk": "workspace:*",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/html": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "better-auth": "1.7.2",
    "bullmq": "^6.3.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "lib0": "^0.2.117",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/bun": "^1.4.0",
    "typescript": "6.0.3"
  }
}
