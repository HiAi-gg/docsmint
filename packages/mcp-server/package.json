{
  "name": "@hiai-docs/mcp-server",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "hiai-docs-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test --path-ignore-patterns=\"*node_modules*\" src",
    "test:unit": "bun run test",
    "test:contract:scoped-live": "bun run --filter '@hiai-docs/sdk' build && bun test tests/integration/scoped-public-surfaces.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hiai-docs/sdk": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.8.0"
  }
}
