{
  "name": "@hiai-docs/db",
  "version": "0.6.8",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./with-tenant": "./src/with-tenant.ts",
    "./document-writer": "./src/document-writer.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun run test:unit && bun run test:contract",
    "test:unit": "bun --no-env-file test --path-ignore-patterns='*node_modules*' ./src/*.test.ts",
    "test:contract": "bun --no-env-file test --path-ignore-patterns='*node_modules*' scripts/migrate.test.ts scripts/migration-owner-sql.test.ts",
    "test:integration": "bun --no-env-file test --path-ignore-patterns='*node_modules*' scripts/pipeline-rls.integration.test.ts scripts/lifecycle-operations.integration.test.ts scripts/reembed-delete-lock.integration.test.ts scripts/embedding-context-migration.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
