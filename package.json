{
  "name": "@hiai-docs/workspace",
  "version": "0.7.0",
  "mcpName": "io.github.HiAi-gg/docsmint",
  "private": true,
  "type": "module",
  "browser": {
    "./packages/sdk/dist/backend-launcher.js": false,
    "./packages/sdk/dist/lifecycle.js": false,
    "./packages/sdk/dist/lifecycle-persistent.js": false,
    "./packages/sdk/dist/lifecycle-runtime.js": false,
    "./packages/sdk/dist/pipeline-cancellation.js": false,
    "./packages/sdk/dist/storage-quota.js": false,
    "./packages/sdk/dist/workspace.js": false,
    "./packages/sdk/dist/backend-pipeline-cancellation.js": false,
    "./packages/sdk/dist/backend-account-runtime-cleanup.js": false
  },
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "license": "Apache-2.0",
  "description": "Self-hosted AI-native knowledge workspace and installable PWA with hybrid search, GraphRAG, REST, SDK, CLI, and MCP access for people and AI agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/docsmint"
  },
  "homepage": "https://github.com/hiai-gg/docsmint#readme",
  "bugs": {
    "url": "https://github.com/hiai-gg/docsmint/issues"
  },
  "keywords": [
    "knowledge-base",
    "knowledge-management",
    "ai-native",
    "ai-agents",
    "wiki",
    "markdown",
    "ai-embeddings",
    "rag",
    "graphrag",
    "semantic-search",
    "self-hosted",
    "pgvector",
    "ollama",
    "local-llm",
    "pwa",
    "progressive-web-app",
    "mcp",
    "offline-knowledge-base",
    "docsmint",
    "outline-alternative",
    "docmost-alternative"
  ],
  "main": "./packages/sdk/dist/index.js",
  "types": "./packages/sdk/dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./packages/sdk/dist/index.js",
      "types": "./packages/sdk/dist/index.d.ts"
    },
    "./sdk": {
      "import": "./packages/sdk/dist/index.js",
      "types": "./packages/sdk/dist/index.d.ts"
    },
    "./mcp": {
      "import": "./packages/mcp-server/src/server.ts",
      "types": "./packages/mcp-server/src/server.ts"
    },
    "./lifecycle": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/lifecycle.js",
      "types": "./packages/sdk/dist/lifecycle.d.ts"
    },
    "./lifecycle/persistent": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/lifecycle-persistent.js",
      "types": "./packages/sdk/dist/lifecycle-persistent.d.ts"
    },
    "./lifecycle/runtime": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/lifecycle-runtime.js",
      "types": "./packages/sdk/dist/lifecycle-runtime.d.ts"
    },
    "./pipeline/cancellation": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/pipeline-cancellation.js",
      "types": "./packages/sdk/dist/pipeline-cancellation.d.ts"
    },
    "./workspace": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/workspace.js",
      "types": "./packages/sdk/dist/workspace.d.ts"
    },
    "./backend/launcher": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/backend-launcher.js",
      "types": "./packages/sdk/dist/backend-launcher.d.ts"
    },
    "./storage-quota": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/storage-quota.js",
      "types": "./packages/sdk/dist/storage-quota.d.ts"
    },
    "./frontend/dashboard": {
      "node": "./packages/sdk/dist/frontend-ssr/dashboard.js",
      "import": "./packages/sdk/dist/frontend/dashboard.js",
      "types": "./packages/sdk/dist/frontend/dashboard.d.ts"
    },
    "./frontend/search": {
      "node": "./packages/sdk/dist/frontend-ssr/search.js",
      "import": "./packages/sdk/dist/frontend/search.js",
      "types": "./packages/sdk/dist/frontend/search.d.ts"
    },
    "./frontend/shared-document": {
      "node": "./packages/sdk/dist/frontend-ssr/shared-document.js",
      "import": "./packages/sdk/dist/frontend/shared-document.js",
      "types": "./packages/sdk/dist/frontend/shared-document.d.ts"
    },
    "./frontend/extension": {
      "node": "./packages/sdk/dist/frontend-ssr/extension.js",
      "import": "./packages/sdk/dist/frontend/extension.js",
      "types": "./packages/sdk/dist/frontend/extension.d.ts"
    },
    "./frontend/api/categories": {
      "import": "./packages/sdk/dist/frontend/api/categories.js",
      "types": "./packages/sdk/dist/frontend/api/categories.d.ts"
    },
    "./frontend/api/documents": {
      "import": "./packages/sdk/dist/frontend/api/documents.js",
      "types": "./packages/sdk/dist/frontend/api/documents.d.ts"
    },
    "./frontend/api/folders": {
      "import": "./packages/sdk/dist/frontend/api/folders.js",
      "types": "./packages/sdk/dist/frontend/api/folders.d.ts"
    },
    "./frontend/api/tags": {
      "import": "./packages/sdk/dist/frontend/api/tags.js",
      "types": "./packages/sdk/dist/frontend/api/tags.d.ts"
    },
    "./frontend/api/settings": {
      "import": "./packages/sdk/dist/frontend/api/settings.js",
      "types": "./packages/sdk/dist/frontend/api/settings.d.ts"
    },
    "./frontend/components/sidebar": {
      "node": "./packages/sdk/dist/frontend-ssr/components/sidebar.js",
      "import": "./packages/sdk/dist/frontend/components/sidebar.js",
      "types": "./packages/sdk/dist/frontend/components/sidebar.d.ts"
    },
    "./frontend/components/settings": {
      "node": "./packages/sdk/dist/frontend-ssr/components/settings.js",
      "import": "./packages/sdk/dist/frontend/components/settings.js",
      "types": "./packages/sdk/dist/frontend/components/settings.d.ts"
    },
    "./frontend/theme": {
      "import": "./packages/sdk/dist/frontend/theme.js",
      "types": "./packages/sdk/dist/frontend/theme.d.ts"
    },
    "./frontend/i18n": {
      "import": "./packages/sdk/dist/frontend/i18n.js",
      "types": "./packages/sdk/dist/frontend/i18n.d.ts"
    },
    "./schema": {
      "import": "./packages/db/src/schema.ts",
      "types": "./packages/db/src/schema.ts"
    },
    "./db": {
      "import": "./packages/db/src/index.ts",
      "types": "./packages/db/src/index.ts"
    },
    "./db/client": {
      "import": "./packages/db/src/client.ts",
      "types": "./packages/db/src/client.ts"
    },
    "./db/with-tenant": {
      "import": "./packages/db/src/with-tenant.ts",
      "types": "./packages/db/src/with-tenant.ts"
    },
    "./backend/lib/redis": {
      "import": "./backend/src/lib/redis-factory.ts",
      "types": "./backend/src/lib/redis-factory.ts"
    },
    "./backend/lib/storage": {
      "import": "./backend/src/lib/storage-factory.ts",
      "types": "./backend/src/lib/storage-factory.ts"
    },
    "./backend/lib/logger": {
      "import": "./backend/src/lib/logger.ts",
      "types": "./backend/src/lib/logger.ts"
    },
    "./backend/lib/rate-limit": {
      "import": "./backend/src/lib/rate-limit-factory.ts",
      "types": "./backend/src/lib/rate-limit-factory.ts"
    },
    "./backend/lib/api-keys": {
      "import": "./backend/src/lib/api-keys.ts",
      "types": "./backend/src/lib/api-keys.ts"
    },
    "./backend/lib/api-key-facade": {
      "import": "./packages/sdk/dist/backend-api-key-facade.js",
      "types": "./backend/src/lib/api-key-facade.ts"
    },
    "./backend/lib/audit": {
      "import": "./backend/src/lib/audit.ts",
      "types": "./backend/src/lib/audit.ts"
    },
    "./backend/pipeline-cancellation": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/backend-pipeline-cancellation.js",
      "types": "./packages/sdk/dist/backend-pipeline-cancellation.d.ts"
    },
    "./backend/account-runtime-cleanup": {
      "browser": "./packages/sdk/dist/server-only-browser-entry.js",
      "import": "./packages/sdk/dist/backend-account-runtime-cleanup.js",
      "types": "./packages/sdk/dist/backend-account-runtime-cleanup.d.ts"
    }
  },
  "bin": {
    "docsmint": "./packages/cli/src/index.ts",
    "docsmint-mcp": "./packages/mcp-server/src/index.ts",
    "hiai-docs": "./packages/cli/src/index.ts",
    "hiai-docs-mcp": "./packages/mcp-server/src/index.ts"
  },
  "files": [
    "packages/sdk/dist",
    "packages/db/src",
    "packages/cli/src",
    "packages/mcp-server/src",
    "skills",
    "backend/src",
    "frontend/src/lib/index.ts",
    "frontend/src/lib/extensions",
    "frontend/src/lib/hosts",
    "frontend/src/lib/stores/doc-tab-registry.svelte.ts",
    "frontend/src/lib/components/editor/shared-document.ts",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">= 1.3.14"
  },
  "scripts": {
    "dev": "docker compose up -d",
    "build": "docker compose build",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run typecheck:scripts && bun run --filter '*' typecheck",
    "typecheck:scripts": "bunx tsc --ignoreConfig --noEmit --strict --skipLibCheck --allowImportingTsExtensions --typeRoots packages/mcp-server/node_modules/@types --types bun --target ESNext --module ESNext --moduleResolution Bundler scripts/release-browser-e2e.ts scripts/release-clean-state.ts scripts/release-docker-smoke.ts scripts/release-gate.ts scripts/release-workflow-contract.ts scripts/secret-scan.ts scripts/verify-published-package.ts scripts/write-release-gate-result.ts",
    "test": "bun run test:unit && bun run test:contract",
    "test:unit": "bun test --path-ignore-patterns='*node_modules*' scripts/*.test.ts && bun run --filter '*' test:unit",
    "test:contract": "bun run --filter '*' test:contract",
    "test:contract:scoped-live": "bun run --filter '@hiai-docs/mcp-server' test:contract:scoped-live",
    "test:integration": "bun run --filter '@hiai-docs/db' test:integration && bun --no-env-file test --path-ignore-patterns='*node_modules*' backend/src/__tests__/content-access-postgres.integration.test.ts backend/src/__tests__/metadata-impact-postgres.integration.test.ts backend/src/__tests__/graph-routes.test.ts packages/db/scripts/query-observer.integration.test.ts && DATABASE_URL=\"${DATABASE_URL:-${CONTENT_ACCESS_TEST_DATABASE_URL:-}}\" bun --no-env-file test --path-ignore-patterns='*node_modules*' backend/src/__tests__/storage-lifecycle-concurrency-postgres.integration.test.ts",
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "build:sdk": "cd packages/sdk && bun run build",
    "test:package": "bun run build:sdk && bun run scripts/verify-packed-package.ts",
    "test:lifecycle:integration": "bun test packages/db/scripts/lifecycle-operations.integration.test.ts",
    "release:check:contract-evidence:task2": "bun run scripts/contract-evidence-validator.ts --phase task2 docs/release/0.7.0-contract-evidence.json",
    "release:check:contract-evidence": "bun run scripts/contract-evidence-validator.ts --phase prepublish docs/release/0.7.0-contract-evidence.json",
    "release:check:contract-evidence:published": "bun run scripts/contract-evidence-validator.ts --phase postpublish docs/release/0.7.0-contract-evidence.json",
    "release:check:audit": "bun audit --production",
    "release:check:secrets": "bun run scripts/secret-scan.ts",
    "release:check:clean": "bun run scripts/release-clean-state.ts",
    "release:check:workflow": "bun run scripts/release-workflow-contract.ts",
    "release:check:browser": "bun run scripts/release-browser-e2e.ts",
    "release:check:docker-smoke": "bun run scripts/release-docker-smoke.ts",
    "release:write:gate-result": "bun run scripts/write-release-gate-result.ts",
    "test:release": "bun run scripts/release-gate.ts",
    "prepublishOnly": "cd packages/sdk && bun run build"
  },
  "overrides": {
    "cookie": "1.1.1",
    "fast-uri": "3.1.5",
    "brace-expansion": "2.1.3",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "bullmq": "^5.80.2",
    "commander": "^13.1.0",
    "ioredis": "^5.11.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "@aws-sdk/client-s3": "^3.0.0",
    "pino": "^10.0.0",
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.56.4"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "pino": {
      "optional": true
    }
  }
}
