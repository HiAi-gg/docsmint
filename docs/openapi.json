  "components": {
    "responses": {
      "AccountPurgeFenced": {
        "description": "The account deletion fence is active; no mutation was admitted.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AccountPurgeFencedError" }
          }
        }
      }
    },
    "schemas": {
      "AccountPurgeFencedError": {
        "type": "object",
        "required": ["error", "code"],
        "additionalProperties": false,
        "properties": {
          "error": { "type": "string", "enum": ["Account deletion is in progress"] },
          "code": { "type": "string", "enum": ["ACCOUNT_PURGE_FENCED"] }
        }
      },
      "AttachmentPresignRequest": {
        "type": "object",
        "required": ["filename", "contentType", "size"],
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
          "contentType": { "type": "string", "pattern": "^image/" },
          "size": { "type": "integer", "minimum": 1 }
        }
      },
      "AttachmentPresignResponse": {
        "type": "object",
        "required": ["url", "key", "uploadToken", "maxSize", "expiresIn"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "key": { "type": "string", "minLength": 1 },
          "uploadToken": {
            "type": "string",
            "minLength": 1,
            "description": "Opaque signed admission identity. Return it verbatim to confirm."
          },
          "quotaReservationId": { "type": "string" },
          "maxSize": { "type": "integer", "minimum": 1 },
          "expiresIn": { "type": "integer", "minimum": 60, "maximum": 3600 }
        }
      },
      "AttachmentConfirmRequest": {
        "type": "object",
        "required": ["key", "uploadToken", "filename", "contentType", "size"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "uploadToken": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
          "contentType": { "type": "string", "pattern": "^image/" },
          "size": { "type": "integer", "minimum": 1 },
          "quotaReservationId": { "type": "string" }
        }
      },
      "WorkspaceResourceScope": {
        "type": "object",
        "description": "Optional category restriction carried only in a trusted server-to-server signed workspace assertion; it is never a browser secret.",
        "required": ["kind", "categoryId", "permissions"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["category"] },
          "categoryId": { "type": "string", "format": "uuid" },
          "permissions": {
            "type": "array",
            "items": { "type": "string", "enum": ["read", "edit", "write"] }
          }
        }
      },
      "WorkspaceAssertionPayload": {
        "type": "object",
        "description": "Trusted server-to-server signed workspace assertion payload. Clients must not create, alter, or expose this payload in browser code.",
        "required": ["actorUserId", "workspaceId", "actorRole", "issuedAt", "expiresAt", "issuer"],
        "additionalProperties": false,
        "properties": {
          "actorUserId": { "type": "string", "format": "uuid" },
          "workspaceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$" },
          "actorRole": { "type": "string", "enum": ["owner", "admin", "editor", "viewer"] },
          "resourceScope": { "$ref": "#/components/schemas/WorkspaceResourceScope" },
          "issuedAt": { "type": "number" },
          "expiresAt": { "type": "number" },
          "issuer": { "type": "string", "minLength": 1 }
        }
      },
      "DocsPipelineStatus": {
        "type": "string",
        "enum": ["pending", "processing", "ready", "retrying", "failed", "ready_with_warnings", "skipped", "cancelled"]
      },
      "DocsDocumentPipeline": {
        "type": "object",
        "nullable": true,
        "required": ["documentId", "generationId", "status", "revision", "stages", "batches", "updatedAt"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "generationId": { "type": "string", "format": "uuid" },
          "status": { "$ref": "#/components/schemas/DocsPipelineStatus" },
          "revision": { "type": "string" },
          "stages": {
            "type": "object",
            "required": ["prepare", "embed", "graph", "summarize", "finalize"],
            "properties": {
              "prepare": { "$ref": "#/components/schemas/DocsPipelineStatus" },
              "embed": { "$ref": "#/components/schemas/DocsPipelineStatus" },
              "graph": { "$ref": "#/components/schemas/DocsPipelineStatus" },
              "summarize": { "$ref": "#/components/schemas/DocsPipelineStatus" },
              "finalize": { "$ref": "#/components/schemas/DocsPipelineStatus" }
            }
          },
          "batches": {
            "type": "object",
            "required": ["total", "completed", "failed"],
            "properties": {
              "total": { "type": "integer" },
              "completed": { "type": "integer" },
              "failed": { "type": "integer" }
            }
          },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "DocsDocumentIndexStatus": {
        "type": "object",
        "required": ["documentId", "embeddingStatus", "activeGenerationId", "pendingGenerationId", "embeddingProfile", "embeddingErrorCode", "embeddingUpdatedAt", "searchable", "pipeline"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "embeddingStatus": { "type": "string", "enum": ["pending", "processing", "ready", "failed", "stale"] },
          "activeGenerationId": { "type": "string", "format": "uuid", "nullable": true },
          "pendingGenerationId": { "type": "string", "format": "uuid", "nullable": true },
          "embeddingProfile": { "type": "string", "nullable": true },
          "embeddingErrorCode": { "type": "string", "nullable": true },
          "embeddingUpdatedAt": { "type": "string", "format": "date-time", "nullable": true },
          "searchable": { "type": "boolean" },
          "pipeline": { "$ref": "#/components/schemas/DocsDocumentPipeline" }
        }
      },
      "DocsDocumentIndexRefresh": {
        "type": "object",
        "required": ["documentId", "generationId", "deduplicated"],
        "properties": {
          "documentId": { "type": "string", "format": "uuid" },
          "generationId": { "type": "string", "format": "uuid" },
          "deduplicated": { "type": "boolean" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "hiai_docs_*",
        "description": "Global or category-scoped DocsMint API key. The operator key is also accepted as a bearer token on operator-capable routes."
      },
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth browser session. Secure deployments may use the __Secure- prefixed cookie name."
      },
      "OperatorApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Static HIAI_DOCS_API_KEY for /api/admin operator endpoints."
      }
    }
  }
}
