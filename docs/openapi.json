    "/api/documents/{id}/index-status": {
      "get": {
        "operationId": "getApiDocumentsByIdIndexStatus",
        "summary": "Read document index status",
        "description": "Returns indexing and knowledge-pipeline status for a document when the caller has read access. A category-scoped workspace assertion is authorized against the document's direct category or its effective category inherited from folder ancestry.",
        "parameters": [
          {
            "schema": { "type": "string", "format": "uuid" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Document index status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DocsDocumentIndexStatus" }
              }
            }
          },
          "400": { "description": "Invalid document identifier." },
          "401": { "description": "Authentication is required." },
          "403": { "description": "The caller lacks the required permission." },
          "404": { "description": "Document not found in the accessible scope." },
          "429": { "description": "Too many requests." }
        },
        "security": [{ "SessionAuth": [] }, { "BearerAuth": [] }]
      }
    },
    "/api/documents/{id}/index/refresh": {
      "post": {
        "operationId": "postApiDocumentsByIdIndexRefresh",
        "summary": "Refresh document index",
        "description": "Requests an idempotent document index refresh when the caller has write access. A category-scoped workspace assertion is authorized against the document's direct category or its effective category inherited from folder ancestry.",
        "parameters": [
          {
            "schema": { "type": "string", "format": "uuid" },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "202": {
            "description": "Document index refresh accepted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DocsDocumentIndexRefresh" }
              }
            }
          },
          "400": { "description": "Invalid document identifier." },
          "401": { "description": "Authentication is required." },
          "403": { "description": "The caller lacks the required permission." },
          "404": { "description": "Document not found in the accessible scope." },
          "429": { "description": "Too many requests." }
        },
        "security": [{ "SessionAuth": [] }, { "BearerAuth": [] }]
      }
    },
