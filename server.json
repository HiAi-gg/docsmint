{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.HiAi-gg/docsmint",
  "title": "DocsMint",
  "description": "Self-hosted AI-native knowledge workspace with hybrid search, GraphRAG, and MCP.",
  "websiteUrl": "https://docsmint.com/docs/mcp",
  "repository": {
    "url": "https://github.com/HiAi-gg/docsmint",
    "source": "github",
    "id": "1249550690",
    "subfolder": "packages/mcp-server"
  },
  "version": "0.7.8",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/HiAi-gg/docsmint/main/frontend/static/logo-dark.png",
      "mimeType": "image/png",
      "sizes": ["256x256"],
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/HiAi-gg/docsmint/main/frontend/static/logo.png",
      "mimeType": "image/png",
      "sizes": ["256x256"],
      "theme": "dark"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@hiai-gg/docsmint",
      "version": "0.7.8",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "docsmint-mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "HIAI_DOCS_URL",
          "description": "Base URL of the DocsMint API.",
          "default": "http://localhost:50700"
        },
        {
          "name": "HIAI_DOCS_API_KEY",
          "description": "Workspace or category scoped DocsMint API key.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://docsmint.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer DocsMint API key.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "X-Docsmint-Workspace",
          "description": "Canonical workspace slug. Bound workspace keys may omit this header.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "license": "Apache-2.0",
      "licenseUrl": "https://www.apache.org/licenses/LICENSE-2.0",
      "licenseFile": "https://github.com/HiAi-gg/docsmint/blob/main/LICENSE",
      "documentationUrl": "https://docsmint.com/docs/mcp",
      "catalog": {
        "tools": 17,
        "prompts": 2,
        "resources": 3
      }
    }
  }
}
